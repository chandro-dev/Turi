# Copia a .env y cambia los valores para cualquier despliegue real.
POSTGRES_PASSWORD=turi_dev_password
JWT_SECRET=cambia-este-secreto-en-produccion
WEB_PORT=8080

# Datos y cuentas de demostracion (true en desarrollo; false en uso real)
SEED_DEMO=true

# Administrador inicial (se crea al arrancar si no existe). Usalo con SEED_DEMO=false.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=

# Motor de estimacion: ema | hybrid (EMA + scikit-learn)
ESTIMATOR=hybrid

# Politica de atencion prioritaria (minutos)
PRIORITY_TARGET_WAIT_MIN=10
PRIORITY_BASE_BONUS_MIN=20
PRIORITY_MAX_BONUS_MIN=60
